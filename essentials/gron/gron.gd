class_name GRON
extends RefCounted

## GRON (Godot Resource Object Notation).
## Static, universal serializer that converts any [Resource] to JSON and back.
## [br][br]
## Every property with [constant PROPERTY_USAGE_STORAGE] is serialized (the same ones
## [ResourceSaver] stores, i.e. [code]@export[/code] variables and native resource properties),
## including nested and shared sub-resources, cyclic references, typed [Array]s and [Dictionary]s
## and every built-in Variant type, without precision loss.
## [br][br]
## Sub-resources saved in their own file under [code]res://[/code] (textures, scripts, .tres files...)
## are stored as a reference to their path/UID, just like a .tres would do. Everything else is embedded.
## [br][br]
## Values that cannot be represented outside of a running game ([Node]s and other non-Resource
## Objects, [RID], [Callable] and [Signal]) are serialized as [code]null[/code].

const VERSION : int = 1
# Integers outside this range are stored as strings, since JSON numbers are parsed as 64-bit floats.
const _MAX_SAFE_INT : int = 9007199254740991

static var _types : Dictionary = {}

## Serializes [param resource] into a JSON string that can be turned back into
## an equivalent [Resource] with [method deserialize].
## [param indent] is passed to [method JSON.stringify] to pretty print the result.
## If [param embed_external] is true, sub-resources saved in their own file are embedded
## instead of referenced by path (scripts are always referenced).
static func serialize(resource : Resource, indent : String = "", embed_external : bool = false) -> String:
	if(resource == null):
		push_error("GRON: Cannot serialize a null Resource.")
		return ""
	var context : Dictionary = {"ids": {}, "entries": [], "embed_external": embed_external}
	_encode_resource(resource, context)
	var data : Dictionary = {"gron": VERSION, "resources": context.entries}
	return JSON.stringify(data, indent, false, true)

## Deserializes a JSON string generated by [method serialize] back into a [Resource].
## Returns [code]null[/code] if the JSON is not valid GRON.
static func deserialize(json : String) -> Resource:
	var parser : JSON = JSON.new()
	if(parser.parse(json) != OK):
		push_error("GRON: Invalid JSON at line " + str(parser.get_error_line()) + ": " + parser.get_error_message())
		return null
	var data : Variant = parser.data
	if(typeof(data) != TYPE_DICTIONARY or typeof(data.get("resources")) != TYPE_ARRAY or data.resources.is_empty()):
		push_error("GRON: The JSON is not a valid GRON document.")
		return null
	if(_json_to_int(data.get("gron", VERSION)) > VERSION):
		push_error("GRON: Document version [" + str(data.gron) + "] is newer than the supported version [" + str(VERSION) + "].")
		return null
	var entries : Array = data.resources
	var resources : Array[Resource] = []
	# First pass: instance every resource, so references (even cyclic ones) can be resolved.
	for entry in entries:
		var resource : Resource = _instantiate_resource(entry)
		if(resource == null):
			return null
		resources.append(resource)
	# Second pass: assign properties. Sub-resources always come after their owner,
	# so going backwards fills them before the resources that use them.
	for i in range(entries.size() - 1, -1, -1):
		var resource : Resource = resources[i]
		var properties : Variant = entries[i].get("properties", {})
		if(typeof(properties) != TYPE_DICTIONARY):
			continue
		for property in properties:
			if(property.begins_with("metadata/")):
				resource.set_meta(property.trim_prefix("metadata/"), _decode(properties[property], resources))
				continue
			if(!(property in resource)):
				push_warning("GRON: Property [" + property + "] does not exist in [" + resource.get_class() + "], skipping.")
				continue
			resource.set(property, _decode(properties[property], resources))
	return resources[0]

#region Encoding

static func _encode_resource(resource : Resource, context : Dictionary) -> int:
	if(context.ids.has(resource)):
		return context.ids[resource]
	var id : int = context.entries.size()
	var entry : Dictionary = {"class": resource.get_class()}
	# Registered before encoding the properties so cyclic references point back to this entry.
	context.ids[resource] = id
	context.entries.append(entry)
	var script : Script = resource.get_script()
	if(script != null):
		if(_is_external(script)):
			entry["script"] = _encode_path(script)
		else:
			push_error("GRON: Built-in scripts are not supported, [" + resource.get_class() + "] will be serialized without its script.")
	var properties : Dictionary = {}
	for property in resource.get_property_list():
		if(!(property.usage & PROPERTY_USAGE_STORAGE) or property.name == "script"):
			continue
		properties[property.name] = _encode(resource.get(property.name), context)
	entry["properties"] = properties
	return id

static func _encode(value : Variant, context : Dictionary) -> Variant:
	var type : int = typeof(value)
	match type:
		TYPE_NIL, TYPE_BOOL, TYPE_STRING:
			return value
		TYPE_FLOAT:
			if(is_finite(value)):
				return value
			return _tag(type, _float_to_json(value))
		TYPE_INT:
			return _tag(type, _int_to_json(value))
		TYPE_STRING_NAME, TYPE_NODE_PATH:
			return _tag(type, String(value))
		TYPE_OBJECT:
			return _encode_object(value, context)
		TYPE_ARRAY:
			return _encode_array(value, context)
		TYPE_DICTIONARY:
			return _encode_dictionary(value, context)
		TYPE_PACKED_BYTE_ARRAY:
			return _tag(type, Marshalls.raw_to_base64(value))
		TYPE_PACKED_STRING_ARRAY:
			return _tag(type, Array(value))
		TYPE_RID, TYPE_CALLABLE, TYPE_SIGNAL:
			push_warning("GRON: Values of type [" + type_string(type) + "] cannot be serialized, storing null instead.")
			return null
	# Math types and the rest of packed arrays are stored as a flat list of numbers.
	return _tag(type, _flatten(value).map(_number_to_json))

static func _encode_object(object : Object, context : Dictionary) -> Variant:
	if(object == null):
		return null
	if(!(object is Resource)):
		push_warning("GRON: Only Resources can be serialized, storing null instead of [" + object.get_class() + "].")
		return null
	if(_is_external(object) and (object is Script or !context.embed_external)):
		return {"$type": "Resource", "$path": _encode_path(object)}
	return {"$type": "Resource", "$ref": _encode_resource(object, context)}

static func _encode_array(array : Array, context : Dictionary) -> Variant:
	var values : Array = array.map(func(value : Variant) -> Variant: return _encode(value, context))
	if(!array.is_typed()):
		return values
	var encoded : Dictionary = _tag(TYPE_ARRAY, values)
	encoded["$of"] = _encode_container_type(array.get_typed_builtin(), array.get_typed_class_name(), array.get_typed_script())
	return encoded

static func _encode_dictionary(dictionary : Dictionary, context : Dictionary) -> Variant:
	var string_keys : bool = dictionary.keys().all(func(key : Variant) -> bool: return typeof(key) == TYPE_STRING)
	var values : Variant
	if(string_keys):
		# Dictionaries with only String keys are stored as JSON objects to keep them readable.
		values = {}
		for key in dictionary:
			values[key] = _encode(dictionary[key], context)
	else:
		values = []
		for key in dictionary:
			values.append([_encode(key, context), _encode(dictionary[key], context)])
	var encoded : Dictionary = _tag(TYPE_DICTIONARY, values)
	if(dictionary.is_typed_key()):
		encoded["$keys"] = _encode_container_type(dictionary.get_typed_key_builtin(), dictionary.get_typed_key_class_name(), dictionary.get_typed_key_script())
	if(dictionary.is_typed_value()):
		encoded["$values"] = _encode_container_type(dictionary.get_typed_value_builtin(), dictionary.get_typed_value_class_name(), dictionary.get_typed_value_script())
	return encoded

static func _encode_container_type(type : int, type_class : StringName, script : Variant) -> Dictionary:
	var encoded : Dictionary = {"type": type_string(type)}
	if(type_class != &""):
		encoded["class"] = String(type_class)
	if(script != null):
		encoded["script"] = _encode_path(script)
	return encoded

static func _encode_path(resource : Resource) -> Dictionary:
	var encoded : Dictionary = {"path": resource.resource_path}
	var uid : int = ResourceLoader.get_resource_uid(resource.resource_path)
	if(uid != ResourceUID.INVALID_ID):
		encoded["uid"] = ResourceUID.id_to_text(uid)
	return encoded

static func _flatten(value : Variant) -> Array:
	match typeof(value):
		TYPE_VECTOR2, TYPE_VECTOR2I:
			return [value.x, value.y]
		TYPE_VECTOR3, TYPE_VECTOR3I:
			return [value.x, value.y, value.z]
		TYPE_VECTOR4, TYPE_VECTOR4I, TYPE_QUATERNION:
			return [value.x, value.y, value.z, value.w]
		TYPE_RECT2, TYPE_RECT2I:
			return _flatten(value.position) + _flatten(value.size)
		TYPE_AABB:
			return _flatten(value.position) + _flatten(value.size)
		TYPE_PLANE:
			return _flatten(value.normal) + [value.d]
		TYPE_TRANSFORM2D:
			return _flatten(value.x) + _flatten(value.y) + _flatten(value.origin)
		TYPE_BASIS:
			return _flatten(value.x) + _flatten(value.y) + _flatten(value.z)
		TYPE_TRANSFORM3D:
			return _flatten(value.basis) + _flatten(value.origin)
		TYPE_PROJECTION:
			return _flatten(value.x) + _flatten(value.y) + _flatten(value.z) + _flatten(value.w)
		TYPE_COLOR:
			return [value.r, value.g, value.b, value.a]
		TYPE_PACKED_INT32_ARRAY, TYPE_PACKED_INT64_ARRAY, TYPE_PACKED_FLOAT32_ARRAY, TYPE_PACKED_FLOAT64_ARRAY:
			return Array(value)
		TYPE_PACKED_VECTOR2_ARRAY, TYPE_PACKED_VECTOR3_ARRAY, TYPE_PACKED_VECTOR4_ARRAY, TYPE_PACKED_COLOR_ARRAY:
			var flat : Array = []
			for element in value:
				flat.append_array(_flatten(element))
			return flat
	push_error("GRON: Unsupported type [" + type_string(typeof(value)) + "].")
	return []

#endregion

#region Decoding

static func _instantiate_resource(entry : Variant) -> Resource:
	if(typeof(entry) != TYPE_DICTIONARY):
		push_error("GRON: Invalid resource entry.")
		return null
	var type_class : String = str(entry.get("class", ""))
	# Only Resources are instanced, to avoid creating arbitrary objects from untrusted JSON.
	if(!ClassDB.class_exists(type_class) or !ClassDB.can_instantiate(type_class) or !ClassDB.is_parent_class(type_class, "Resource")):
		push_error("GRON: Cannot instance a Resource of class [" + type_class + "].")
		return null
	var resource : Resource = ClassDB.instantiate(type_class)
	if(entry.has("script")):
		var script : Script = _load_path(entry.script) as Script
		if(script == null or !script.can_instantiate() or !ClassDB.is_parent_class(type_class, script.get_instance_base_type())):
			push_error("GRON: Cannot load a valid script for [" + type_class + "] from " + str(entry.script) + ".")
			return null
		resource.set_script(script)
	return resource

static func _decode(data : Variant, resources : Array[Resource]) -> Variant:
	match typeof(data):
		TYPE_ARRAY:
			return data.map(func(value : Variant) -> Variant: return _decode(value, resources))
		TYPE_DICTIONARY:
			return _decode_tagged(data, resources)
	return data

static func _decode_tagged(data : Dictionary, resources : Array[Resource]) -> Variant:
	var type_name : String = str(data.get("$type", ""))
	var value : Variant = data.get("$value")
	if(type_name == "Resource"):
		if(data.has("$path")):
			return _load_path(data["$path"])
		var id : int = _json_to_int(data.get("$ref", -1))
		if(id < 0 or id >= resources.size()):
			push_error("GRON: Invalid Resource reference [" + str(data.get("$ref")) + "].")
			return null
		return resources[id]
	var type : int = _get_type(type_name)
	match type:
		TYPE_INT:
			return _json_to_int(value)
		TYPE_FLOAT:
			return _json_to_float(value)
		TYPE_STRING_NAME:
			return StringName(str(value))
		TYPE_NODE_PATH:
			return NodePath(str(value))
		TYPE_ARRAY:
			return _decode_array(data, resources)
		TYPE_DICTIONARY:
			return _decode_dictionary(data, resources)
		TYPE_PACKED_BYTE_ARRAY:
			return Marshalls.base64_to_raw(str(value))
		TYPE_PACKED_STRING_ARRAY:
			return PackedStringArray(value)
		-1, TYPE_NIL, TYPE_BOOL, TYPE_STRING, TYPE_OBJECT, TYPE_RID, TYPE_CALLABLE, TYPE_SIGNAL:
			push_error("GRON: Invalid value of type [" + type_name + "].")
			return null
	if(typeof(value) != TYPE_ARRAY):
		push_error("GRON: Invalid value for type [" + type_name + "].")
		return null
	return _unflatten(type, value)

static func _decode_array(data : Dictionary, resources : Array[Resource]) -> Array:
	var values : Array = _decode(data.get("$value", []), resources)
	if(!data.has("$of")):
		return values
	var of : Array = _decode_container_type(data["$of"])
	var typed : Array = Array([], of[0], of[1], of[2])
	typed.assign(values)
	return typed

static func _decode_dictionary(data : Dictionary, resources : Array[Resource]) -> Dictionary:
	var values : Variant = data.get("$value", {})
	var dictionary : Dictionary = {}
	if(typeof(values) == TYPE_DICTIONARY):
		for key in values:
			dictionary[key] = _decode(values[key], resources)
	elif(typeof(values) == TYPE_ARRAY):
		for pair in values:
			dictionary[_decode(pair[0], resources)] = _decode(pair[1], resources)
	if(!data.has("$keys") and !data.has("$values")):
		return dictionary
	var keys : Array = _decode_container_type(data.get("$keys"))
	var vals : Array = _decode_container_type(data.get("$values"))
	var typed : Dictionary = Dictionary({}, keys[0], keys[1], keys[2], vals[0], vals[1], vals[2])
	typed.assign(dictionary)
	return typed

# Returns [type, class_name, script] as expected by the typed Array and Dictionary constructors.
static func _decode_container_type(data : Variant) -> Array:
	if(typeof(data) != TYPE_DICTIONARY):
		return [TYPE_NIL, &"", null]
	var type : int = maxi(_get_type(str(data.get("type", ""))), TYPE_NIL)
	var script : Script = _load_path(data.script) as Script if data.has("script") else null
	return [type, StringName(data.get("class", "")), script]

static func _unflatten(type : int, v : Array) -> Variant:
	var integer : bool = type in [TYPE_VECTOR2I, TYPE_VECTOR3I, TYPE_VECTOR4I, TYPE_RECT2I, TYPE_PACKED_INT32_ARRAY, TYPE_PACKED_INT64_ARRAY]
	var n : Array = v.map(_json_to_int if integer else _json_to_float)
	match type:
		TYPE_VECTOR2:
			return Vector2(n[0], n[1])
		TYPE_VECTOR2I:
			return Vector2i(n[0], n[1])
		TYPE_VECTOR3:
			return Vector3(n[0], n[1], n[2])
		TYPE_VECTOR3I:
			return Vector3i(n[0], n[1], n[2])
		TYPE_VECTOR4:
			return Vector4(n[0], n[1], n[2], n[3])
		TYPE_VECTOR4I:
			return Vector4i(n[0], n[1], n[2], n[3])
		TYPE_QUATERNION:
			return Quaternion(n[0], n[1], n[2], n[3])
		TYPE_RECT2:
			return Rect2(n[0], n[1], n[2], n[3])
		TYPE_RECT2I:
			return Rect2i(n[0], n[1], n[2], n[3])
		TYPE_AABB:
			return AABB(Vector3(n[0], n[1], n[2]), Vector3(n[3], n[4], n[5]))
		TYPE_PLANE:
			return Plane(n[0], n[1], n[2], n[3])
		TYPE_TRANSFORM2D:
			return Transform2D(Vector2(n[0], n[1]), Vector2(n[2], n[3]), Vector2(n[4], n[5]))
		TYPE_BASIS:
			return Basis(Vector3(n[0], n[1], n[2]), Vector3(n[3], n[4], n[5]), Vector3(n[6], n[7], n[8]))
		TYPE_TRANSFORM3D:
			return Transform3D(_unflatten(TYPE_BASIS, v.slice(0, 9)), Vector3(n[9], n[10], n[11]))
		TYPE_PROJECTION:
			return Projection(Vector4(n[0], n[1], n[2], n[3]), Vector4(n[4], n[5], n[6], n[7]), Vector4(n[8], n[9], n[10], n[11]), Vector4(n[12], n[13], n[14], n[15]))
		TYPE_COLOR:
			return Color(n[0], n[1], n[2], n[3])
		TYPE_PACKED_INT32_ARRAY:
			return PackedInt32Array(n)
		TYPE_PACKED_INT64_ARRAY:
			return PackedInt64Array(n)
		TYPE_PACKED_FLOAT32_ARRAY:
			return PackedFloat32Array(n)
		TYPE_PACKED_FLOAT64_ARRAY:
			return PackedFloat64Array(n)
		TYPE_PACKED_VECTOR2_ARRAY:
			return PackedVector2Array(_unflatten_elements(TYPE_VECTOR2, v, 2))
		TYPE_PACKED_VECTOR3_ARRAY:
			return PackedVector3Array(_unflatten_elements(TYPE_VECTOR3, v, 3))
		TYPE_PACKED_VECTOR4_ARRAY:
			return PackedVector4Array(_unflatten_elements(TYPE_VECTOR4, v, 4))
		TYPE_PACKED_COLOR_ARRAY:
			return PackedColorArray(_unflatten_elements(TYPE_COLOR, v, 4))
	push_error("GRON: Unsupported type [" + type_string(type) + "].")
	return null

static func _unflatten_elements(type : int, v : Array, size : int) -> Array:
	var elements : Array = []
	for start in range(0, v.size(), size):
		elements.append(_unflatten(type, v.slice(start, start + size)))
	return elements

static func _load_path(data : Variant) -> Resource:
	if(typeof(data) != TYPE_DICTIONARY):
		push_error("GRON: Invalid Resource path [" + str(data) + "].")
		return null
	var path : String = str(data.get("path", ""))
	# The UID takes priority, so references survive files being moved around in the project.
	if(data.has("uid")):
		var uid : int = ResourceUID.text_to_id(str(data.uid))
		if(uid != ResourceUID.INVALID_ID and ResourceUID.has_id(uid)):
			path = ResourceUID.get_id_path(uid)
	# Only project resources are loaded, to avoid loading arbitrary files from untrusted JSON.
	if(!path.begins_with("res://") or !ResourceLoader.exists(path)):
		push_error("GRON: Cannot load Resource at [" + path + "].")
		return null
	return load(path)

#endregion

#region Helpers

static func _tag(type : int, value : Variant) -> Dictionary:
	return {"$type": type_string(type), "$value": value}

static func _get_type(type_name : String) -> int:
	if(_types.is_empty()):
		for type in TYPE_MAX:
			_types[type_string(type)] = type
	return _types.get(type_name, -1)

static func _is_external(resource : Resource) -> bool:
	return resource.resource_path.begins_with("res://") and !resource.resource_path.contains("::")

static func _number_to_json(number : Variant) -> Variant:
	if(typeof(number) == TYPE_INT):
		return _int_to_json(number)
	return _float_to_json(number)

static func _int_to_json(number : int) -> Variant:
	if(number > _MAX_SAFE_INT or number < -_MAX_SAFE_INT):
		return str(number)
	return number

static func _json_to_int(data : Variant) -> int:
	if(typeof(data) == TYPE_STRING):
		return data.to_int()
	return int(data)

static func _float_to_json(number : float) -> Variant:
	if(is_nan(number)):
		return "nan"
	if(is_inf(number)):
		return "inf" if number > 0 else "-inf"
	return number

static func _json_to_float(data : Variant) -> float:
	match data:
		"nan":
			return NAN
		"inf":
			return INF
		"-inf":
			return -INF
	return float(data)

#endregion
